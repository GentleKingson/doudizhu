  "measurement_policy": {
    "attempt_scope": "measure only this attempt start/end iteration range and its wall time; do not label a resumed 250-to-500 attempt a complete 500-iteration run",
    "retained_training_path_seconds": "job-level aggregate of recorded training intervals contributing to the final verified 0-to-500 state lineage, including initialization and snapshot/logging overhead on that lineage; excludes discarded repeated training; if unobservable, leave null and explain",
    "total_runtime_seconds_all_attempts": "job-level sum of all allocated runtime intervals attributed to the job across successful/failed/retried attempts, including initialization/build, training, capture/upload, waiting and restoration/replay; independent evaluation is tagged as a separate resource category unless explicitly attributed",
    "additive_cost_rule": "training-attempt wall totals already contain their capture/upload/logging subintervals; never add those subintervals again; sum non-overlapping runtime allocation intervals for actual cost",
    "later_throughput_window": "iterations 101-500; report gross window and any explicitly excluded checkpoint/transfer intervals separately",
    "campaign_cost": "sum all non-overlapping billed runtime intervals, including independent evaluation, installation, idle time, retries and validation; shared setup overhead uses one declared attribution rule",
    "cost_comparison": "use total actual resource cost and report interruption/retry effects separately; do not select a candidate as faster by counting only its final partial resume attempt"
  },
